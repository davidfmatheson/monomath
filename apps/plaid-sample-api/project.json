{
  "name": "plaid-sample-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/plaid-sample-api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/dist/apps/plaid-sample-api"],
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "plaid-sample-api:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "plaid-sample-api:build:development"
        },
        "production": {
          "buildTarget": "plaid-sample-api:build:production"
        }
      }
    }
  }
}
